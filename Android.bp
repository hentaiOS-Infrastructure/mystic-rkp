package {
    default_team: "trendy_team_android_hardware_backed_security",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "mystic.attestation.provisioner",
    local_include_dir: "aidl",
    srcs: [
        "aidl/mystic/attestation/provisioner/AttestationKeyCertificateProfile.aidl",
        "aidl/mystic/attestation/provisioner/HardeningStageContext.aidl",
        "aidl/mystic/attestation/provisioner/HardeningStageResult.aidl",
        "aidl/mystic/attestation/provisioner/IBackendAttestationKeyProvisioner.aidl",
        "aidl/mystic/attestation/provisioner/ProvisionedAttestationKey.aidl",
        "aidl/mystic/attestation/provisioner/ProtectedStageCompletion.aidl",
    ],
    unstable: true,
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
        ndk: {
            enabled: false,
        },
        rust: {
            enabled: true,
        },
    },
}

rust_protobuf {
    name: "libdroidfood_attestation_proto_rust",
    crate_name: "droidfood_attestation_proto",
    source_stem: "droidfood_attestation_proto",
    protos: ["proto/overwrite.proto"],
}

rust_protobuf {
    name: "libmystic_hardening_proto_rust",
    crate_name: "mystic_hardening_proto",
    source_stem: "mystic_hardening_proto",
    protos: ["proto/hardening.proto"],
}

rust_library {
    name: "libtonic_mystic",
    crate_name: "tonic",
    crate_root: "grpc-rust/tonic/src/lib.rs",
    cargo_env_compat: true,
    cargo_pkg_version: "0.14.6",
    edition: "2024",

    clippy_lints: "none",

    features: [
        "_tls-any",
        "channel",
        "tls-connect-info",
        "tls-native-roots",
        "tls-aws-lc",
    ],

    rustlibs: [
        "libbase64_rust",
        "libbytes",
        "libhttp",
        "libhttp_body",
        "libhttp_body_util",
        "libhyper",
        "libhyper_timeout",
        "libhyper_util",
        "libpercent_encoding",
        "libpin_project",
        "librustls_native_certs",
        "libsync_wrapper",
        "libtokio",
        "libtokio_rustls",
        "libtokio_stream",
        "libtokio_util",
        "libtower",
        "libtower_layer",
        "libtower_service",
        "libtracing",
    ],
    min_sdk_version: "29",
}

rust_dependencies = [
    "android.security.postprocessor-rust",
    "libandroid_logger",
    "libbinder_rs",
    "liblog_rust",
    "libopenssl",
    "libbytes",
    "libhttp",
    "libprotobuf",
    "libtokio",
    "libtonic_mystic",
    "librustutils",
    "libuuid",
    "libdroidfood_attestation_proto_rust",
    "libmystic_hardening_proto_rust",
    "mystic.attestation.provisioner-rust",
]

rust_library {
    name: "libdroidfoodattestation",
    crate_name: "droidfoodattestation",
    srcs: ["src/lib.rs"],
    rustlibs: rust_dependencies,
    static_libs: [
        "libcutils",
        "libclang_rt.ubsan_minimal",
    ],
    defaults: [
        "keymint_use_latest_hal_aidl_rust",
        "keystore2_use_latest_aidl_rust",
    ],
}

rust_test {
    name: "droidfoodattestation_tests",
    crate_name: "droidfoodattestation_tests",
    srcs: ["src/lib.rs"],
    rustlibs: rust_dependencies,
    static_libs: [
        "libcutils",
        "libclang_rt.ubsan_minimal",
    ],
    defaults: [
        "keymint_use_latest_hal_aidl_rust",
        "keystore2_use_latest_aidl_rust",
    ],
    test_suites: ["general-tests"],
}

rust_binary {
    name: "rkp_cert_processor",
    crate_name: "droidfoodattestation",
    srcs: ["src/main.rs"],
    init_rc: ["droidfoodattestation.rc"],
    rustlibs: rust_dependencies + ["libdroidfoodattestation"],
    prefer_rlib: true,
    bootstrap: true,
    system_ext_specific: true,
}

prebuilt_etc {
    name: "android.security.postprocessor.init.rc",
    src: "droidfoodattestation.rc",
    filename: "init.rc",
    installable: true,
    system_ext_specific: true,
}
